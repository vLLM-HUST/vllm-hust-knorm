   } >> "$GITHUB_ENV"
 }
 
+print_file_tail() {
+  local label=$1
+  local path=$2
+  local lines=${3:-120}
+
+  if [[ -f "$path" ]]; then
+    echo "---- ${label}: ${path} (last ${lines} lines) ----" >&2
+    tail -n "$lines" "$path" >&2
+    echo "---- end ${label} ----" >&2
+  else
+    echo "---- ${label}: ${path} not found ----" >&2
+  fi
