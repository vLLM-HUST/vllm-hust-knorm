+    external_root.mkdir()
+    external_raw = external_root / "raw_benchmark.json"
+    external_raw.write_text("{}\n", encoding="utf-8")
+    external_submission = _write_submission(external_root, "outside")
+    summary = _write_scenario_summary(
+        result_root,
+        [
+            (
+                "random-online",
+                "outside",
+                str(external_root),
+                str(external_raw),
+                str(external_submission),
